# Lecture Memo 설정
# AUDIO_CHUNK_SECONDS 허용 범위: 5~600초
# AUDIO_CHUNK_OVERLAP_SECONDS 허용 범위: 0~30초
# 겹침 시간은 청크 길이보다 작아야 합니다.

GEMINI_MODEL=gemini-3.6-flash
MOCK_GEMINI=false

# 로컬 개발은 local, Render 운영은 multi_user를 사용합니다.
APP_AUTH_MODE=local
LOCAL_ACCESS_TOKEN=

# Render 운영 사용자(최대 7명). 실제 토큰은 Render Secret에만 입력합니다.
# APP_USER_1_ID=user-001
# APP_USER_1_TOKEN=
# APP_USER_2_ID=user-002
# APP_USER_2_TOKEN=

# 설치된 확장 프로그램 ID를 고정할 때 사용합니다.
# ALLOWED_EXTENSION_ORIGINS=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# 확장 프로그램이 한 번에 녹음하여 전송할 오디오 길이와 청크 간 겹침입니다.
# 허용 범위: 길이 5~600초, 겹침 0~30초이며 겹침은 길이보다 작아야 합니다.
AUDIO_CHUNK_SECONDS=300
AUDIO_CHUNK_OVERLAP_SECONDS=5

MAX_CHUNK_BYTES=6000000
MAX_REQUEST_BYTES=6500000

# DELETE 요청이 오지 않은 비정상 종료 세션을 메모리에서 정리하는 시간입니다.
# 허용 범위: 60~86400초
SESSION_IDLE_TTL_SECONDS=1800

# Render 운영에서는 Atlas URI와 REQUIRED=true를 설정합니다.
MONGODB_URI=
MONGODB_DATABASE=lecture_memo
MONGODB_DOCUMENT_COLLECTION=lecture_documents
MONGODB_SESSION_COLLECTION=lecture_sessions
MONGODB_CHUNK_COLLECTION=lecture_session_chunks
MONGODB_REQUIRED=false
INCOMPLETE_DRAFT_RETENTION_DAYS=7
