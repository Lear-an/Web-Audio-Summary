# Lecture Memo V8 / OpenAI 운영 설정
# AUDIO_CHUNK_SECONDS: 15~180초, OVERLAP: 0~30초(청크보다 작아야 함)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-6-luna
MOCK_OPENAI=false
SAFETY_IDENTIFIER_SECRET=

# 로컬 개발은 local, Render 운영은 atlas_users
APP_AUTH_MODE=local
LOCAL_ACCESS_TOKEN=
ADMIN_ACCESS_TOKEN=

# 기존 multi_user 계정을 atlas_users로 전환할 때만 아래 ID·해시를 임시로 넣어 이관합니다.
# APP_USER_1_ID=user-001
# APP_USER_1_TOKEN_SHA256=
MAX_REGISTERED_USERS=10
MAX_CONCURRENT_USERS=5
ACTIVE_USER_LEASE_SECONDS=180

# atlas_users 모드에서는 PC별 확장 origin 등록이 필요하지 않습니다.

AUDIO_CHUNK_SECONDS=15
AUDIO_CHUNK_OVERLAP_SECONDS=1
AUDIO_BITS_PER_SECOND=64000
MAX_CHUNK_BYTES=6000000
MAX_REQUEST_BYTES=6500000
MAX_SESSION_DURATION_SECONDS=14400
MAX_DOCUMENT_BYTES=12000000

OPENAI_MAX_IN_FLIGHT=3
OPENAI_QUEUE_WAIT_SECONDS=30
OPENAI_TRANSCRIBE_TIMEOUT_SECONDS=90
OPENAI_TEXT_TIMEOUT_SECONDS=60
PROCESSING_LEASE_SECONDS=180
FINALIZE_LEASE_SECONDS=180
SESSION_IDLE_TTL_SECONDS=1800
DRAFT_RETENTION_DAYS=7

MONGODB_URI=
MONGODB_DATABASE=lecture_memo
MONGODB_DOCUMENT_COLLECTION=lecture_documents
MONGODB_SESSION_COLLECTION=lecture_sessions
MONGODB_CHUNK_COLLECTION=lecture_session_chunks
MONGODB_SERVICE_STATE_COLLECTION=service_state
MONGODB_DAILY_USAGE_COLLECTION=daily_usage
MONGODB_REQUIRED=false

# 0은 제한하지 않음. 운영 관측 후 설정합니다.
DAILY_AUDIO_MINUTES_LIMIT_PER_USER=0
DAILY_AUDIO_MINUTES_LIMIT_TOTAL=0
