# Lecture Memo 설정
# AUDIO_CHUNK_SECONDS 허용 범위: 5~600초
# AUDIO_CHUNK_OVERLAP_SECONDS 허용 범위: 0~30초
# 겹침 시간은 청크 길이보다 작아야 합니다.

GEMINI_MODEL=gemini-3.6-flash

# 비워두면 서버 시작 시 임의 토큰을 생성해 콘솔에 한 번 표시합니다.
LOCAL_ACCESS_TOKEN=

# 설치된 확장 프로그램 ID를 고정할 때 사용합니다.
# ALLOWED_EXTENSION_ORIGIN=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Gemini 호출 없이 전체 UI 흐름을 점검할 때 true로 설정합니다.
MOCK_GEMINI=false

# 확장 프로그램이 한 번에 녹음하여 전송할 오디오 길이와 청크 간 겹침입니다.
# 허용 범위: 길이 5~600초, 겹침 0~30초이며 겹침은 길이보다 작아야 합니다.
AUDIO_CHUNK_SECONDS=10
AUDIO_CHUNK_OVERLAP_SECONDS=1

MAX_CHUNK_BYTES=1000000
MAX_REQUEST_BYTES=1300000

# DELETE 요청이 오지 않은 비정상 종료 세션을 메모리에서 정리하는 시간입니다.
# 허용 범위: 60~86400초
SESSION_IDLE_TTL_SECONDS=1800
